[
    // Whimsy
    {
        "key": "ctrl+s ctrl+b",
        "command": "workbench.action.toggleStatusbarVisibility"
    },
    // Navigation
    {
        "key": "alt+enter",
        "command": "workbench.action.focusActiveEditorGroup"
    },
    {
        "key": "alt+h",
        "command": "workbench.action.navigateLeft",
    },
    {
        "key": "alt+j",
        "command": "workbench.action.navigateDown",
    },
    {
        "key": "alt+k",
        "command": "workbench.action.navigateUp",
    },
    {
        "key": "alt+l",
        "command": "workbench.action.navigateRight",
    },
    // Escape webview editors (PDF preview): navigate* is a no-op from a focused
    // webview (VS Code #100536), so fall back to grid-group focus there.
    {
        "key": "alt+h",
        "command": "workbench.action.focusLeftGroup",
        "when": "activeCustomEditorId == 'latex-workshop-pdf-hook'"
    },
    {
        "key": "alt+j",
        "command": "workbench.action.focusBelowGroup",
        "when": "activeCustomEditorId == 'latex-workshop-pdf-hook'"
    },
    {
        "key": "alt+k",
        "command": "workbench.action.focusAboveGroup",
        "when": "activeCustomEditorId == 'latex-workshop-pdf-hook'"
    },
    {
        "key": "alt+l",
        "command": "workbench.action.focusRightGroup",
        "when": "activeCustomEditorId == 'latex-workshop-pdf-hook'"
    },
    {
        "key": "space ,",
        "command": "workbench.action.showAllEditors",
        "when": "filesExplorerFocus || sideBarFocus || searchViewletFocus"
    },
    {
        "key": "tab",
        "command": "workbench.action.nextEditorInGroup",
        "when": "!inputFocus"
    },
    {
        "key": "shift+tab",
        "command": "workbench.action.previousEditorInGroup",
        "when": "!inputFocus"
    },
    {
        "key": "space space",
        "command": "workbench.action.quickOpen",
        "when": "filesExplorerFocus || sideBarFocus || searchViewletFocus"
    },
    {
        "key": "space g g",
        "command": "workbench.view.scm",
        "when": "filesExplorerFocus || sideBarFocus || searchViewletFocus"
    },
    {
        "key": "space e",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.toggleSidebarVisibility",
                "workbench.action.focusActiveEditorGroup"
            ]
        },
        "when": "filesExplorerFocus || sideBarFocus || searchViewletFocus"
    },
    {
        "key": "space t",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active && (filesExplorerFocus || sideBarFocus || searchViewletFocus)"
    },
    {
        "key": "ctrl+w",
        "command": "workbench.action.closeActiveEditor",
        "when": "!editorTextFocus && !filesExplorerFocus && !searchViewletFocus && !terminalFocus && neovim.mode != 'cmdline'"
    },
    // File Tree
    {
        "key": "e",
        "command": "explorer.openToSide",
        "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "o",
        "command": "runCommands",
        "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
        "args": {
            "commands": [
                "workbench.action.splitEditorDown",
                "explorer.openAndPassFocus",
                "workbench.action.closeOtherEditors"
            ]
        }
    },
    // Notebook
    {
        "key": "enter",
        "command": "notebook.cell.execute",
        "when": "notebookEditorFocused && !inputFocus || notebookEditorFocused && neovim.mode == 'normal'"
    },
    {
        "key": "j",
        "command": "runCommands",
        "args": {
            "commands": [
                "list.focusDown",
                "list.scrollDown",
                "list.scrollUp"
            ]
        },
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "k",
        "command": "runCommands",
        "args": {
            "commands": [
                "list.focusUp",
                "list.scrollUp",
                "list.scrollDown"
            ]
        },
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "l",
        "command": "notebook.cell.edit",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "a",
        "command": "notebook.cell.insertCodeCellAbove",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "b",
        "command": "notebook.cell.insertCodeCellBelow",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "d d",
        "command": "notebook.cell.delete",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "ctrl+j",
        "command": "notebook.cell.moveDown",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "ctrl+k",
        "command": "notebook.cell.moveUp",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "m",
        "command": "notebook.cell.changeToMarkdown",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "y",
        "command": "notebook.cell.changeToCode",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "shift+x",
        "command": "notebook.clearAllCellsOutputs",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "space f",
        "command": "notebook.formatCell",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "/",
        "command": "notebook.find",
        "when": "notebookEditorFocused && !inputFocus"
    },
    // Shoo!
    {
        "key": "ctrl+n",
        "command": "-workbench.action.files.newUntitledFile"
    },
    {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+alt+b",
        "command": "-workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "f",
        "command": "-notebook.find",
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
]